{
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=600, must-revalidate" }
        ]
      },
      {
        "source": "/icons/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/splash/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/og/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/time{,/}",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/time",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebaseignore",
      ".git",
      ".git/**",
      "**/.*",
      "**/node_modules/**",
      "mobile/**",
      "**/*.md",
      "_template.html",
      "analyst-pipeline/**",
      "life-signal/functions/**",
      "life-signal/firestore.rules",
      "life-signal/firebase.json",
      "life-signal/firebase-config.example.js",
      "**/*.bak",
      "**/*.BACKUP-*.html",
      "atmr-dashboard [0-9]*.html",
      "swing-signal-mockup.html",
      "gauge-preview.html",
      "_og-render.html",
      "**/*.py",
      "**/*.sh",
      "**/*.plist",
      "_github-setup/**",
      "next.config.mjs",
      "tsconfig.json",
      "tailwind.config.js",
      "postcss.config.js",
      "vercel.json",
      "package.json",
      "package-lock.json"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
