{
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "ezlong-541a8",
    "public": ".",
    "headers": [
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=600, must-revalidate"
          }
        ]
      },
      {
        "source": "/icons/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/splash/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/og/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/time{,/}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/time",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebaseignore",
      ".git",
      ".git/**",
      "**/.*",
      "**/node_modules/**",
      "mobile/**",
      "**/*.md",
      "_template.html",
      "analyst-pipeline/**",
      "life-signal/functions/**",
      "life-signal/firestore.rules",
      "life-signal/firebase.json",
      "life-signal/firebase-config.example.js",
      "**/*.bak",
      "**/*.BACKUP-*.html",
      "atmr-dashboard [0-9]*.html",
      "swing-signal-mockup.html",
      "gauge-preview.html",
      "_og-render.html",
      "**/*.py",
      "**/*.sh",
      "**/*.plist",
      "scripts/**",
      "_github-setup/**",
      "next.config.mjs",
      "tsconfig.json",
      "tailwind.config.js",
      "postcss.config.js",
      "vercel.json",
      "package.json",
      "package-lock.json",
      "data/market-regime.json",
      "data/market-regime-history.json",
      "data/.cache/**"
    ],
    "redirects": [
      {
        "source": "/stocks.html",
        "destination": "/chart-analysis.html",
        "type": 301
      },
      {
        "source": "/stocks_v2.html",
        "destination": "/chart-analysis.html",
        "type": 301
      },
      {
        "source": "/en/stocks.html",
        "destination": "/en/chart-analysis.html",
        "type": 301
      },
      {
        "source": "/ja/stocks.html",
        "destination": "/ja/chart-analysis.html",
        "type": 301
      },
      {
        "source": "/zh/stocks.html",
        "destination": "/zh/chart-analysis.html",
        "type": 301
      },
      {
        "source": "/es/stocks.html",
        "destination": "/es/chart-analysis.html",
        "type": 301
      },
      {
        "source": "/pt/stocks.html",
        "destination": "/pt/chart-analysis.html",
        "type": 301
      }
    ]
  }
}
